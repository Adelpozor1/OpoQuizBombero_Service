# Copiar a .env y rellenar los valores.
# Los valores por defecto abajo coinciden con docker-compose.yml para desarrollo local.

DB_HOST=localhost
DB_PORT=5432
DB_USER=opoquiz_user
DB_PASSWORD=opoquiz_pass
DB_NAME=opoquiz

# Puerto del backend Express. Debe ser 3001 en local
# porque el frontend hace fetch a http://localhost:3001/...
PORT=3001

# Origen permitido en CORS (frontend).
CORS_ORIGIN=http://localhost:3000

# Coste de bcrypt para el registro. 12 = ~250ms por hash, buen balance
# seguridad/rendimiento. Subir a 13-14 si el hardware lo permite.
BCRYPT_COST=12

# Numero de saltos de proxy hasta el service. 0 si no hay reverse proxy,
# 1 si esta detras de nginx/cloudflare/etc. Necesario para que el rate limit
# vea la IP real del cliente.
TRUST_PROXY=1

# JWT: secreto (>=32 chars) y expiraciones.
# Generar con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia_esto_por_algo_generado_con_crypto_randomBytes_48
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES_DAYS=30

# Cookie del refresh token. En prod (https) COOKIE_SECURE=true.
COOKIE_SECURE=false
COOKIE_SAMESITE=strict
